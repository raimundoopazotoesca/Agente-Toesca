# ── API Key de Google AI Studio (Gemini) ────────────────────────────────────
# Obtener en: https://aistudio.google.com → Get API key → Create API key
GEMINI_API_KEY=AIza...ponla-aqui...

# API Key de Mistral (fallback final del chat inmobiliario)
# Obtener en: https://console.mistral.ai
MISTRAL_API_KEY=

# Servidor HTTP opcional (`python agent.py --server`). Generar un secreto largo,
# por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SERVER_API_TOKEN=
# Por seguridad escucha solo en localhost. Para Power Automate en red, usar
# 0.0.0.0 únicamente junto con firewall y el token anterior.
AGENT_SERVER_HOST=127.0.0.1

# ── Servidor de ingesta (`python -m scripts.ingesta_server`) ─────────────────
# Token exigido en todo /api/*. Si no se define, se genera uno por sesión y se
# imprime al arrancar (cambia en cada reinicio). Fíjalo aquí para tener uno
# estable. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGESTA_TOKEN=

# ── SharePoint sincronizado por OneDrive ─────────────────────────────────────
# Windows: C:\Users\tu_usuario\OneDrive - Empresa\Documentos
# Mac:     /Users/tu_usuario/Library/CloudStorage/OneDrive-Empresa/Documentos
SHAREPOINT_DIR=

# ── Ruta directa a la carpeta Comercial de Renta ─────────────────────────────
# Carpeta que contiene subcarpetas por año (2025/, 2026/, etc.)
# Windows (SharePoint): C:\Users\raimundo.opazo\OneDrive - Empresa\...\Control de Gestión Históricos\Comercial
# Windows (R: drive):   R:\Planillas\Rentas\Control de Gestión Rentas Inmobiliarias\Control de Gestión Históricos\Comercial
# Mac:                  /Users/tu_usuario/Library/CloudStorage/OneDrive-Empresa/...\Comercial
RENTA_COMERCIAL_DIR=

# ── Servidor local / unidad de red (solo Windows, opcional) ──────────────────
# Solo necesario si usas el servidor R: en lugar de SharePoint
# LOCAL_FILES_DIR=R:\Planillas

# ── Archivo histórico Saldo Caja (default: ./work/saldo_caja/) ───────────────
# Carpeta donde se guardan todas las planillas de María José Castro
# Si no se configura, se usa WORK_DIR/saldo_caja/ automáticamente
# SALDO_CAJA_DIR=C:\Users\raimundo.opazo\OneDrive - Empresa\...\Saldo Caja

# ── Directorio de trabajo temporal (default: ./work) ─────────────────────────
# WORK_DIR=C:\Users\raimundo.opazo\automation_agent\work
