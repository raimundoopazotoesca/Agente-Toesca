{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "toesca-analyst-benchmark/judge_output.schema.json",
  "title": "Rubric judge structured output",
  "type": "object",
  "required": ["response_mode", "dimensions", "gates"],
  "additionalProperties": false,
  "properties": {
    "response_mode": {
      "enum": ["answered", "clarified", "declined"],
      "description": "answered: attempted a substantive response. clarified: asked the user a clarifying question instead of answering. declined: explicitly stated it could not / would not answer (no question asked back). Judge classifies this from the response text; infra_failure and empty-text model_non_answer are decided deterministically before the judge ever runs, not by the judge."
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analytical_quality": {"$ref": "#/definitions/dimension_score"},
        "grounding": {"$ref": "#/definitions/dimension_score"},
        "hallucination": {"$ref": "#/definitions/dimension_score"},
        "clarification_judgment": {"$ref": "#/definitions/dimension_score"},
        "investigation_quality": {"$ref": "#/definitions/dimension_score"},
        "output_usefulness": {"$ref": "#/definitions/dimension_score"},
        "tool_correctness": {"$ref": "#/definitions/dimension_score"}
      },
      "required": [
        "analytical_quality", "grounding", "hallucination",
        "clarification_judgment", "investigation_quality",
        "output_usefulness", "tool_correctness"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "F1_fabrication": {"$ref": "#/definitions/gate_verdict"},
        "C4_unsupported_causality": {"$ref": "#/definitions/gate_verdict"},
        "C5_forbidden_claim": {"$ref": "#/definitions/gate_verdict"}
      },
      "required": ["F1_fabrication", "C4_unsupported_causality", "C5_forbidden_claim"]
    }
  },
  "definitions": {
    "dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_applicable", "confidence"],
      "properties": {
        "not_applicable": {
          "type": "boolean",
          "description": "true if this dimension genuinely does not apply to this case/turn. When true, score/justification/evidence are omitted."
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Required when not_applicable is false."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences explaining the score against the rubric anchor. Required when not_applicable is false."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "A concrete quote or reference from the response/query results that supports the score -- not a restatement of the justification. Required when not_applicable is false."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Judge's own confidence in this score, always required (even when not_applicable)."
        }
      }
    },
    "gate_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggered", "confidence"],
      "properties": {
        "triggered": {
          "type": "boolean",
          "description": "Whether this gate fires for this response."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "description": "Required when triggered is true."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete quote from the response supporting the verdict. Required when triggered is true."
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
